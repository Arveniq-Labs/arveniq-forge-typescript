{
  "name": "@arveniq/forge-sdk",
  "version": "0.3.0",
  "description": "Developer SDK for Arveniq Forge O/S governed tool package manifests and deployment APIs.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Arveniq Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arveniq-Labs/arveniq-forge-typescript.git"
  },
  "homepage": "https://github.com/Arveniq-Labs/arveniq-forge-typescript#readme",
  "bugs": {
    "url": "https://github.com/Arveniq-Labs/arveniq-forge-typescript/issues"
  },
  "keywords": [
    "arveniq",
    "forge",
    "tool-packages",
    "sdk",
    "governance",
    "agents"
  ],
  "bin": {
    "forge-tool": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples",
    "LICENSE"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node bin/make-cli-executable.js",
    "clean": "rm -rf dist",
    "test": "tsx --test test/*.test.ts",
    "test:mobile": "tsx --test packages/mobile-core/test/*.test.ts packages/capacitor/test/*.test.ts",
    "build:mobile": "npm run build --workspace=@arveniq/forge-mobile-core && npm run build --workspace=@arveniq/forge-react-native && npm run build --workspace=@arveniq/forge-expo && npm run build --workspace=@arveniq/forge-capacitor",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:mobile": "npm run build:mobile",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
